# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Secrets / env（任何含真实密钥的 env 一律不入库，示例文件 .env.example 除外。
# 填好的 backend/.env 曾携带真实 API Key/SMTP 授权码/AES 主密钥入库，已出库并需轮换密钥）
backend/.env
backend/.env.development
backend/.env.local
/.env
deploy/.env.production
deploy/generated/
backend/uploads/
# 从仓库根 cwd 跑 backend e2e（经 test 符号链接）时产物落在根 uploads/
/uploads/
# 仓库根 test 符号链接（jest 兼容层用，见 backend/jest.config.js 头注释，不入库，缺失时兼容层自动关闭）
/test

# 临时探针/验证脚本
*.tmp.js
*.tmp.js.map

# ZCode 工作流定义（本地工具产物，不入库）
.zcode/

# TypeScript incremental build cache
*.tsbuildinfo
