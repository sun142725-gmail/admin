PUBLISH_SECRET=replace-with-strong-secret
PORT=9090
PROJECT_PATH=/path/to/rbac
# 线上脚本：白名单扩展名（逗号分隔，默认 .sql）
# ONLINE_SCRIPT_EXTS=.sql
# 线上脚本单次执行超时毫秒，超时 SIGKILL 强杀并释放锁（默认 600000 = 10 分钟）
# ONLINE_SCRIPT_TIMEOUT_MS=600000
# 刷新脚本列表时 git pull --ff-only 的超时毫秒（默认 30000）；pull 失败/超时不阻塞列表返回，
# 失败原因随响应 pull 字段提示，执行期基线安全仍由 run-online.sh 的 fail-closed pull 兜底
# ONLINE_PULL_TIMEOUT_MS=30000
