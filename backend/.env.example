NODE_ENV=development
PORT=3000
APP_NAME=rbac
JWT_ACCESS_SECRET=rbac_access_secret
JWT_REFRESH_SECRET=rbac_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=rbac
DB_PASSWORD=rbac
DB_NAME=rbac
DB_SYNC=true
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=60
SEED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
DICT_CACHE_TTL=21600
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
FEISHU_BOT_WEBHOOK=

# ---- 微服务转发（BFF 网关，/api/svc/*）----
# 全局默认超时毫秒（拿到上游响应头为止）；0 表示不限时
PROXY_DEFAULT_TIMEOUT_MS=60000
# Go 核心服务目标地址（含基路径；compose 环境内为 http://core:8081/api/v1）
PROXY_CORE_TARGET=http://127.0.0.1:8081/api/v1

# ---- 日志审计（log-center）----
# 前端/错误日志保留天数（查询窗口与每日 3 点清理任务共用此值；审计日志 audit_logs 长期保留）
LOG_RETENTION_DAYS=7
