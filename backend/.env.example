NODE_ENV=development
PORT=3000
APP_NAME=rbac
JWT_ACCESS_SECRET=rbac_access_secret
JWT_REFRESH_SECRET=rbac_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=rbac
DB_PASSWORD=rbac
DB_NAME=rbac
DB_SYNC=true
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=60
SEED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
DICT_CACHE_TTL=21600
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
FEISHU_BOT_WEBHOOK=

# ---- 微服务转发（BFF 网关，/api/svc/*）----
# 全局默认超时毫秒（拿到上游响应头为止）；0 表示不限时
PROXY_DEFAULT_TIMEOUT_MS=60000
# Go 核心服务目标地址（含基路径；compose 环境内为 http://core:8081/api/v1）
PROXY_CORE_TARGET=http://127.0.0.1:8081/api/v1
# 内部接口令牌：Go 流水线回调 /api/internal/ai/*（chat/image/提示词模板）用；未配置时内部接口全部拒绝（fail-closed）
INTERNAL_API_TOKEN=

# ---- 内部 AI 接口超时预算（internal-ai，多候选故障转移用）----
# 单候选超预算即切下一个候选。上游硬上限是 adapter 内 AbortSignal.timeout(120s)，
# 本层预算应 ≥ 该值；Go 侧等待预算请按 ≥300s 配置。TTS 与 image 共用 IMAGE 预算。
INTERNAL_AI_CHAT_TIMEOUT_MS=180000
INTERNAL_AI_IMAGE_TIMEOUT_MS=300000

# ---- 日志审计（log-center）----
# 前端/错误日志保留天数（查询窗口与每日 3 点清理任务共用此值；审计日志 audit_logs 长期保留）
LOG_RETENTION_DAYS=7

# ---- 小说转视频 / TTS 配音 ----
# 对外公网地址（如 https://media.example.com）：i2v 图生视频需要把首帧 /uploads/ 图拼成公网 URL 传给上游；
# 未配置时自动回落文生视频，并在项目 stage_message 提示
APP_PUBLIC_BASE_URL=
# TTS 默认音色（OpenAI 兼容 /audio/speech 的 voice 参数；项目未配置 ttsVoice 时使用）
TTS_DEFAULT_VOICE=alloy
# TTS 上游调用超时毫秒
TTS_TIMEOUT_MS=60000
# 字幕烧录字体文件绝对路径（如 /usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc）：
# 注入 ffmpeg subtitles 滤镜 fontsdir（所在目录）与 FontName（文件名去扩展名），中文字幕必需；
# 缺省不注入 fontsdir，交给 fontconfig 兜底。注意容器需安装含 libass 的 ffmpeg 及中文字体
# （如 fonts-noto-cjk），缺 subtitles 滤镜时带字幕合成会明确报错。
NOVEL_SUBTITLE_FONT_FILE=
