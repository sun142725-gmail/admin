# docker-compose 根环境变量示例：复制为 .env 后填入真实值（.env 不入库）。
# 生成强随机值：openssl rand -hex 32
# 注意：示例中不再提供任何可用默认密钥——所有密钥都必须显式生成。

# ---- 必填（缺失时 compose 拒绝启动，fail-closed）----
# JWT 签名密钥（backend 与 Go core 共用 ACCESS 密钥验签）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 数据面
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
# 部署面板密钥（面板挂载 docker.sock 与 SSH 私钥，必须强随机且不外传）
PUBLISH_SECRET=
# 内部接口令牌：Go 流水线回调 /api/internal/ai/*（chat/image/提示词模板）与 backend 网关内部令牌，二者共用同值（生成方式：openssl rand -hex 32）
INTERNAL_API_TOKEN=

# ---- Go core 服务变量边界说明 ----
# core 容器的 PORT/GIN_MODE/DB_*/NODE_BASE_URL/UPLOAD_DIR 与 backend 侧 PROXY_CORE_TARGET
# 均为 docker-compose.yml 内定值（core:8081、连 mysql 服务、上传目录与 backend 同卷），不经本文件插值；
# core 仅从本文件取 JWT_ACCESS_SECRET（与 backend 共用验签）与 INTERNAL_API_TOKEN 两个变量。

# ---- 按需 ----
# 首启播种管理员的初始密码（缺省为 password，生产必须覆盖）
SEED_ADMIN_PASSWORD=
# 生产建表方式：true=TypeORM synchronize（开发方便），false=需自行 migration（生产推荐）
DB_SYNC=false
# 允许跨域的源（逗号分隔；经 nginx 同源反代时无需通配）
CORS_ORIGIN=http://localhost,http://127.0.0.1
# 前端/错误日志保留天数（审计日志长期保留）
LOG_RETENTION_DAYS=7
# 服务端日志文件化：true 时控制台日志同步按天写入 LOG_FILE_DIR/app-YYYY-MM-DD.log（旁路，写失败不影响服务）
LOG_FILE_ENABLED=false
LOG_FILE_DIR=./logs
# 部署面板指向的宿主机项目路径
HOST_PROJECT_PATH=/home/sun142725/admin
# 部署面板线上脚本模块本地调参（可选，不进 compose 插值，容器内用 server.js 默认值）：
# ONLINE_SCRIPT_EXTS（扩展名白名单，默认 .sql；放宽需同步修改执行器 run-online.sh 的正则与执行方式）、
# ONLINE_SCRIPT_TIMEOUT_MS（执行超时，默认 600000）——取值示例见 deploy-panel/.env.example

# ---- 股票日线行情库盘后补抓（stock/daily-bars，全部可选走默认）----
# STOCK_BARS_ENABLED=false 关闭（默认开启；NODE_ENV=test 自动不跑）
STOCK_BARS_ENABLED=true
# 盘后补抓 cron（默认工作日 16:20，与选股扫描 15:30 错峰；注意服务器时区）
STOCK_BARS_CRON=20 16 * * 1-5
# 串行逐标的间隔毫秒=上游限流（默认 300）
STOCK_BARS_INTERVAL_MS=300
# 单轮最多处理标的数（默认 200，余量下轮续跑；三源全挂最坏 ~24s/标的，需收紧调小此值）
STOCK_BARS_MAX_PER_RUN=200
# 首抓/扩窗根数（默认 250；缺口窗口外判定同源）
STOCK_BARS_INIT_BARS=250
# 候选池命中回看天数（默认 7：自选 ∪ 近 N 天 completed 扫描命中）
STOCK_BARS_POOL_DAYS=7

# ---- 业务可选（不配自动降级）----
AI_ENCRYPTION_KEY=
BOCHA_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
FEISHU_BOT_WEBHOOK=
