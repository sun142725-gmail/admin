# 生产环境变量模板：复制为 deploy/.env.production 并填入真实值（该文件已 gitignore）
# 说明：shell 已导出的变量优先于本文件；backend/.env 仅作开发兜底。

# ---- 数据库（必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=rbac
DB_PASSWORD=change-me
DB_NAME=rbac
DB_SYNC=true

# ---- 登录态（必填，生产务必换随机值；Go core 服务共用 JWT_ACCESS_SECRET 验签网关转发的 token）----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ---- 内部接口令牌（必填）：Go core 流水线回调 /api/internal/ai/* 需与 backend 同值（openssl rand -hex 32 生成）----
# 本文件语境是宿主机直跑 backend；Go core 服务变量（PORT/GIN_MODE/DB_*/NODE_BASE_URL/UPLOAD_DIR/PROXY_CORE_TARGET）
# 由 docker-compose.yml core 段提供，不经本文件，此处只需保证 INTERNAL_API_TOKEN 与 compose 根 .env 一致。
INTERNAL_API_TOKEN=change-me

# ---- 内部 AI 接口超时预算（internal-ai，多候选故障转移用）----
# 单候选超预算即切下一个候选。上游硬上限是 adapter 内 AbortSignal.timeout(120s)，
# 本层预算应 ≥ 该值；Go 侧等待预算请按 ≥300s 配置。TTS 与 image 共用 IMAGE 预算。
INTERNAL_AI_CHAT_TIMEOUT_MS=180000
INTERNAL_AI_IMAGE_TIMEOUT_MS=300000

# ---- 部署面板密钥（compose 根 .env 语境，不经本文件插值）----
# deploy-panel 的 PUBLISH_SECRET 由 docker-compose.yml 从根 .env 注入（fail-closed，缺失拒绝启动）；
# 面板挂载 docker.sock 与 SSH 私钥，生产根 .env 的 PUBLISH_SECRET 必须强随机（openssl rand -hex 32）且不外传。

# ---- AI 加密密钥（必填，上线后不可更换）----
AI_ENCRYPTION_KEY=change-me-64-hex-random
# 线上加密密钥（生成发布 SQL 时重加密 API Key 用；与上面 AI_ENCRYPTION_KEY 相同）
TARGET_AI_ENCRYPTION_KEY=change-me-64-hex-random

# ---- AI 模型直连（同步脚本用其创建/绑定模型行；也是解卦兜底）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 全量发布 SQL 生成（02-generate-ai-sql.sh 用）：源库 = 开发环境 ----
# 生成脚本强制显式指定 SOURCE_*，防止误把线上库当数据源
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USERNAME=rbac
SOURCE_DB_PASSWORD=change-me
SOURCE_DB_NAME=rbac
SOURCE_AI_ENCRYPTION_KEY=change-me-dev-encryption-key

# ---- 消息面联网检索（可选，股市圆桌用；不配则降级为公告+F10+模型知识注入）----
# 博查（国内直连）与 Tavily（海外）二选一，优先博查
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ---- 限流兜底（throttler v5：ttl 单位为毫秒）----
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60

# ---- 运行环境（production 时关闭 Swagger 文档）----
NODE_ENV=production

# ---- 冒烟验证目标（03 脚本用）----
BASE_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1

# 日志保留天数（log-center 查询窗口与每日清理任务共用；审计日志长期保留）
LOG_RETENTION_DAYS=7
# 服务端日志文件化：true 时控制台日志同步按天写入 LOG_FILE_DIR/app-YYYY-MM-DD.log（旁路，写失败不影响服务）
LOG_FILE_ENABLED=false
# 容器部署请挂载该目录（docker-compose 已映射 ./logs/backend:/app/logs），否则文件随容器重建丢失
LOG_FILE_DIR=/app/logs

# ---- 小说转视频 / TTS 配音 ----
# 对外公网地址（如 https://media.example.com）：i2v 图生视频需要把首帧 /uploads/ 图拼成公网 URL 传给上游；
# 未配置时自动回落文生视频，并在项目 stage_message 提示
APP_PUBLIC_BASE_URL=
# TTS 默认音色（OpenAI 兼容 /audio/speech 的 voice 参数；项目未配置 ttsVoice 时使用）
TTS_DEFAULT_VOICE=alloy
# TTS 上游调用超时毫秒
TTS_TIMEOUT_MS=60000
# 字幕烧录字体文件绝对路径（如 /usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc）：
# 注入 ffmpeg subtitles 滤镜 fontsdir（所在目录）与 FontName（文件名去扩展名），中文字幕必需；
# 缺省不注入 fontsdir，交给 fontconfig 兜底。注意容器需安装含 libass 的 ffmpeg 及中文字体
# （如 fonts-noto-cjk），缺 subtitles 滤镜时带字幕合成会明确报错。
NOVEL_SUBTITLE_FONT_FILE=

# ---- AI 成本单价兜底（单价表无匹配行时报表兜底价）----
# 单价口径：chat=每 1K token（输入/输出分开计价）；image=每张；video=每秒；tts=每字符
# 留空或非法值 = 该类无兜底价（报表该类金额显示为未覆盖）；币种缺省 CNY
AI_PRICE_CHAT_INPUT=
AI_PRICE_CHAT_OUTPUT=
AI_PRICE_IMAGE=
AI_PRICE_VIDEO_PER_SEC=
AI_PRICE_TTS_PER_CHAR=
AI_PRICE_CURRENCY=CNY
