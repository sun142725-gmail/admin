# 生产环境变量模板：复制为 deploy/.env.production 并填入真实值（该文件已 gitignore）
# 说明：shell 已导出的变量优先于本文件；backend/.env 仅作开发兜底。

# ---- 数据库（必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=rbac
DB_PASSWORD=change-me
DB_NAME=rbac
DB_SYNC=true

# ---- 登录态（必填，生产务必换随机值）----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ---- AI 加密密钥（必填，上线后不可更换）----
AI_ENCRYPTION_KEY=change-me-64-hex-random

# ---- AI 模型直连（同步脚本用其创建/绑定模型行；也是解卦兜底）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 冒烟验证目标（02 脚本用）----
BASE_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1
