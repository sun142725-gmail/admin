# 生产环境变量模板：复制为 deploy/.env.production 并填入真实值（该文件已 gitignore）
# 说明：shell 已导出的变量优先于本文件；backend/.env 仅作开发兜底。

# ---- 数据库（必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=rbac
DB_PASSWORD=change-me
DB_NAME=rbac
DB_SYNC=true

# ---- 登录态（必填，生产务必换随机值）----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ---- AI 加密密钥（必填，上线后不可更换）----
AI_ENCRYPTION_KEY=change-me-64-hex-random
# 线上加密密钥（生成发布 SQL 时重加密 API Key 用；与上面 AI_ENCRYPTION_KEY 相同）
TARGET_AI_ENCRYPTION_KEY=change-me-64-hex-random

# ---- AI 模型直连（同步脚本用其创建/绑定模型行；也是解卦兜底）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 全量发布 SQL 生成（02-generate-ai-sql.sh 用）：源库 = 开发环境 ----
# 生成脚本强制显式指定 SOURCE_*，防止误把线上库当数据源
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USERNAME=rbac
SOURCE_DB_PASSWORD=change-me
SOURCE_DB_NAME=rbac
SOURCE_AI_ENCRYPTION_KEY=change-me-dev-encryption-key

# ---- 冒烟验证目标（03 脚本用）----
BASE_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1
